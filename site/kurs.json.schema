{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kurs.json.schema",
  "title": "Kurs",
  "description": "Dokument koji čas i studio čitaju. Isporučeni kurs je kursevi/web_programiranje/kurs.json. Putanja slike bez kose crte na početku je relativna u odnosu na folder kursa.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "themeCount",
    "topics"
  ],
  "properties": {
    "institution": {
      "type": "string"
    },
    "institutionLine": {
      "type": "string"
    },
    "institutionSide": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "emblem": {
      "type": "string"
    },
    "themeCount": {
      "type": "number"
    },
    "version": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "executionStatus": {
      "type": "string"
    },
    "targetGroup": {
      "type": "string"
    },
    "introduction": {
      "$ref": "#/$defs/uvod"
    },
    "firstPrerequisite": {
      "type": "string"
    },
    "connectingExample": {
      "$ref": "#/$defs/povezujuciPrimer"
    },
    "teachingPattern": {
      "$ref": "#/$defs/nastavniObrazac"
    },
    "glossaryAdditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glosar"
      }
    },
    "integrationNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tema"
      }
    }
  },
  "$defs": {
    "uvod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "goal",
        "expectations",
        "foundations"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "expectations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "foundations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sentence"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "link": {
                "type": "string"
              },
              "sentence": {
                "type": "string"
              }
            }
          }
        },
        "foundationsNote": {
          "type": "string"
        }
      }
    },
    "jezik": {
      "type": "string",
      "enum": [
        "html",
        "css",
        "text",
        "javascript",
        "json",
        "sql",
        "typescript"
      ]
    },
    "opcija": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "text",
        "ok",
        "why"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "why": {
          "type": "string"
        }
      }
    },
    "pitalicaKoraka": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/opcija"
          }
        },
        "promptAnalysis": {
          "type": "string"
        }
      }
    },
    "cvor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "oznaka": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "label"
      ],
      "properties": {
        "year": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "figura": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "put",
            "linija"
          ]
        },
        "motion": {
          "type": "string",
          "enum": [
            "redom",
            "jednom"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cvor"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/oznaka"
          }
        }
      }
    },
    "dijagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "text"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "samostalniPrimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "isolated",
        "text"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/jezik"
        },
        "isolated": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "pojam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "hint",
        "body",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "codeLanguage": {
          "$ref": "#/$defs/jezik"
        }
      }
    },
    "glosar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "hint",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "inCourse": {
          "type": "string"
        }
      }
    },
    "rezerva": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "options"
      ],
      "properties": {
        "problem": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opcija"
          }
        }
      }
    },
    "samostalno": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introduction",
        "detailedMaterial",
        "workflow",
        "knowledgeBounds",
        "comprehensionCheck"
      ],
      "properties": {
        "introduction": {
          "type": "string"
        },
        "detailedMaterial": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workflow": {
          "type": "string"
        },
        "knowledgeBounds": {
          "type": "string"
        },
        "comprehensionCheck": {
          "type": "string"
        }
      }
    },
    "primer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editorExample",
        "id",
        "execution",
        "language",
        "code",
        "title",
        "level",
        "explanation",
        "expectedResult",
        "deferredAnswer",
        "environment",
        "options",
        "question",
        "changeAndVerify",
        "correctAnswer",
        "applicationImpact",
        "introduction",
        "applicationRelation",
        "kind"
      ],
      "properties": {
        "editorExample": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "execution": {
          "type": "string",
          "enum": [
            "konceptualno",
            "izolovano",
            "uz-pripremljeno-okruzenje",
            "uz-postgres-lab",
            "uz-typescript-okolinu"
          ]
        },
        "language": {
          "$ref": "#/$defs/jezik"
        },
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "expectedResult": {
          "type": "string"
        },
        "expectedException": {
          "type": "string"
        },
        "deferredAnswer": {
          "type": "boolean"
        },
        "deferredAnswerText": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opcija"
          }
        },
        "question": {
          "type": "string"
        },
        "fixSuggestion": {
          "type": "string"
        },
        "testEnvironmentSetup": {
          "type": "string"
        },
        "changeAndVerify": {
          "type": "string"
        },
        "fixCheck": {
          "type": "string"
        },
        "correctAnswer": {
          "type": "string"
        },
        "applicationImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "applicationImpactText": {
          "type": "string"
        },
        "introduction": {
          "type": "string"
        },
        "applicationRelation": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "predvidi",
            "ispravi-gresku"
          ]
        }
      }
    },
    "blokLekcije": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "tekst",
            "highlight",
            "kod",
            "dijagram",
            "mermaid",
            "struktura",
            "raspored",
            "pitanje"
          ]
        },
        "text": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "kljucna",
            "obicna"
          ]
        },
        "title": {
          "type": "string"
        },
        "background": {
          "type": "string",
          "enum": [
            "bela",
            "crna"
          ]
        },
        "language": {
          "$ref": "#/$defs/jezik"
        },
        "link": {
          "type": "string",
          "enum": [
            "samostalniPrimer",
            "dijagram",
            "prica",
            "fajl",
            "figura",
            "http",
            "komanda"
          ]
        },
        "form": {
          "type": "string",
          "enum": [
            "tekst",
            "izbor"
          ]
        },
        "answer": {
          "type": "string"
        },
        "analysis": {
          "type": "string"
        },
        "extra": {
          "type": "string"
        },
        "extraAnswer": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/opcija"
          }
        }
      }
    },
    "korak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "minutes": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "story": {
          "type": "string"
        },
        "keyIdea": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opcija"
          }
        },
        "promptAnalysis": {
          "type": "string"
        },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pitalicaKoraka"
          }
        },
        "promptCheck": {
          "type": "string"
        },
        "exampleKind": {
          "type": "string",
          "enum": [
            "aplikacija",
            "eksperiment",
            "pitalica-kod"
          ]
        },
        "path": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "snippetTitle": {
          "type": "string"
        },
        "snippetLanguage": {
          "$ref": "#/$defs/jezik"
        },
        "fragment": {
          "type": "string"
        },
        "original": {
          "type": "string"
        },
        "originalLanguage": {
          "$ref": "#/$defs/jezik"
        },
        "figure": {
          "$ref": "#/$defs/figura"
        },
        "diagram": {
          "$ref": "#/$defs/dijagram"
        },
        "standaloneExample": {
          "$ref": "#/$defs/samostalniPrimer"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blokLekcije"
          }
        },
        "discussion": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blokLekcije"
          }
        }
      }
    },
    "tema": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title",
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "minutes": {
          "type": "number"
        },
        "lectureMinutes": {
          "type": "number"
        },
        "discussionMinutes": {
          "type": "number"
        },
        "prerequisite": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "assumption": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/opcija"
          }
        },
        "reserve": {
          "$ref": "#/$defs/rezerva"
        },
        "reserveNote": {
          "type": "string"
        },
        "exit": {
          "type": "string"
        },
        "lessonTerms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pojam"
          }
        },
        "extraExamples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/primer"
          }
        },
        "independentTasks": {
          "type": "string"
        },
        "independentLearning": {
          "$ref": "#/$defs/samostalno"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/korak"
          }
        }
      }
    },
    "faza": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minutes",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "minutes": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "povezujuciPrimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "nastavniObrazac": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepNote",
        "pedagogicalNote",
        "exampleKinds",
        "stepOrder",
        "discussionPhases",
        "exitForm"
      ],
      "properties": {
        "stepNote": {
          "type": "string"
        },
        "pedagogicalNote": {
          "type": "string"
        },
        "exampleKinds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "stepOrder": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discussionPhases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budgetMinutes",
            "phases",
            "after",
            "note"
          ],
          "properties": {
            "budgetMinutes": {
              "type": "number"
            },
            "phases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/faza"
              }
            },
            "after": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minutes",
                "description"
              ],
              "properties": {
                "minutes": {
                  "type": "number"
                },
                "description": {
                  "type": "string"
                }
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "exitForm": {
          "type": "string"
        },
        "independentLearning": {
          "type": "string"
        },
        "editorExtraExamples": {
          "type": "string"
        },
        "noReact": {
          "type": "string"
        },
        "learningWithoutInstructor": {
          "type": "string"
        },
        "codeCheck": {
          "type": "string"
        },
        "timeAllocation": {
          "type": "string"
        },
        "executionStatus": {
          "type": "string"
        }
      }
    }
  }
}
